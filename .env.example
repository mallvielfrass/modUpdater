# Скопируйте в .env. Файл .env не коммитится.
# Сервер читает переменные процесса, не сам файл.
# Перед запуском: set -a && source .env && set +a
# Клиент Tauri, Vite и Forge читают .env при сборке.

# Адрес сервиса. Без пути и без завершающего слэша.
# Пустое значение при сборке клиента заменяется на http://127.0.0.1:8080
MODUPDATER_SERVER_URL=

# Сервер. Непустые значения перекрывают config.json.
MODUPDATER_LISTEN=
MODUPDATER_DATA_DIR=
MODUPDATER_PUBLIC_URL=
MODUPDATER_ROOT_USERNAME=
MODUPDATER_ROOT_PASSWORD=
MODUPDATER_SYSTEMD_UNIT=
MODUPDATER_RESTART_WARNING=
MODUPDATER_RESTART_DELAY_SEC=
MODUPDATER_RCON_HOST=
MODUPDATER_RCON_PORT=
MODUPDATER_RCON_PASSWORD=

# make upgrade. Хост в формате ssh, например user@host.
MODUPDATER_DEPLOY_HOST=
MODUPDATER_DEPLOY_PATH=

# Необязательно: готовый Bearer для scripts/release-client.sh и scripts/upload-forge.py.
# Иначе скрипт спросит логин и пароль в терминале.
MODUPDATER_TOKEN=
